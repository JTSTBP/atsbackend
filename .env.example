EMAIL_ID=
APP_PASSWORD=
SENDER_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TRANSPORT_MODE=direct-ipv4-587
SMTP_FALLBACK_MODES=direct-ipv4-587,ipv4-lookup-587,ssl-465,default-587,custom-socket-587
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_TEST_TIMEOUT_MS=8000
SMTP_KEEP_PASSWORD_SPACES=false
SMTP_REJECT_UNAUTHORIZED=true

MONTHLY_ATTENDANCE_CRON=0 9 1 * *
MONTHLY_ATTENDANCE_TIMEZONE=Asia/Kolkata
MONTHLY_ATTENDANCE_RECIPIENT=
STATEMENT_UPLOAD_MAX_FILE_SIZE_BYTES=5242880
