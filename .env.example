EMAIL_ID=
APP_PASSWORD=
SENDER_ID=

EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TRANSPORT_MODE=direct-ipv4-587
SMTP_FALLBACK_MODES=direct-ipv4-587,direct-ipv4-465,ipv4-lookup-587,ipv4-lookup-465,ssl-465,gmail-service,default-587,custom-socket-587
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_TEST_TIMEOUT_MS=8000
SMTP_KEEP_PASSWORD_SPACES=false
SMTP_REJECT_UNAUTHORIZED=true

MONTHLY_ATTENDANCE_CRON=0 9 1 * *
MONTHLY_ATTENDANCE_TIMEZONE=Asia/Kolkata
MONTHLY_ATTENDANCE_RECIPIENT=

CEO_DAILY_REPORT_12PM_CRON=0 12 * * *
CEO_DAILY_REPORT_7PM_CRON=0 19 * * *
CEO_DAILY_REPORT_TIMEZONE=Asia/Kolkata
CEO_DAILY_REPORT_ENABLE_INTERVAL_CATCHUP=false
CEO_DAILY_REPORT_CATCHUP_INTERVAL_MINUTES=0
CEO_DAILY_REPORT_CRON_SECRET=
CEO_DAILY_REPORT_EMAIL_PROVIDER=smtp
CEO_DAILY_REPORT_RECIPIENTS=
CEO_DAILY_REPORT_CC=
CEO_DAILY_REPORT_DASHBOARD_URL=

STATEMENT_UPLOAD_MAX_FILE_SIZE_BYTES=5242880

# Optional WhatsApp provider for recruiter follow-ups.
# Leave WHATSAPP_PROVIDER empty/none until a real provider endpoint is available.
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Microsoft email: delegated OAuth for Outlook.com and Microsoft 365.
# Web redirect URI must match the Microsoft Entra app registration exactly.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/microsoft-mail/callback
# Set FRONTEND_URL to the real frontend origin (for example http://localhost:5173).
# Generate a 32-byte base64 key using the command in docs/microsoft-email.md.
MICROSOFT_TOKEN_ENCRYPTION_KEY=
